	  <None Update="MOZILLA-7375-0.pdf">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	  <None Update="11194059_2017-11_de_s.pdf">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
